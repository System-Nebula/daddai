# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_client_id
GUILD_ID=your_guild_id
TEST_GUILD_ID=your_test_guild_id

# Web Server Configuration
WEB_PORT=3000

# Python Configuration
PYTHON_PATH=python

# Refactored Agent Server Configuration
REFACTORED_AGENT_HOST=localhost
REFACTORED_AGENT_PORT=8766
REFACTORED_AGENT_TIMEOUT=120000
REFACTORED_AGENT_AGENTIC_TIMEOUT=180000
REFACTORED_AGENT_HTTPS=false

# Refactored RAG Server Configuration
REFACTORED_RAG_HOST=localhost
REFACTORED_RAG_PORT=8767
REFACTORED_RAG_TIMEOUT=60000
REFACTORED_RAG_HTTPS=false

# LLM Configuration (for Python backend)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# Optional: LMStudio Configuration
# LLM_PROVIDER=lmstudio
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=model-identifier

# Optional: Chutes Configuration
# LLM_PROVIDER=chutes
# CHUTES_API_KEY=your_chutes_api_key
# CHUTES_MODEL=model-identifier
