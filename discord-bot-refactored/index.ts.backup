    context_chunks?: number | Array<unknown>;
    memories_used?: number;
    source_documents?: string[];
    source_memories?: Array<{ type: string; content: string; score?: number }>;
    is_casual_conversation?: boolean;
    service_routing?: string;
    tool_calls?: Array<{
        tool: string;
        result?: {
            result?: {
                success?: boolean;
                image_base64?: string;
                image_path?: string;
                filename?: string;
                error?: string;
            };
            success?: boolean;
            image_base64?: string;
            image_path?: string;
