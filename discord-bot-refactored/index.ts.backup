// Use persistent GopherAgent service by default (much faster, no process spawning)
// Set USE_GOPHER_AGENT_HTTP=true to use HTTP mode instead
const usePersistentGopherAgent = process.env.USE_GOPHER_AGENT_HTTP !== 'true';

// RouteMessageContext type for compatibility
interface RouteMessageContext {
    hasAttachments?: boolean;
    has_attachments?: boolean;
    isMentioned?: boolean;
    is_mentioned?: boolean;
    userId?: string;
    channelId?: string;
    guildId?: string;
    username?: string;
    recentMessages?: Array<{ role?: string; author?: string; content: string }>;
    [key: string]: unknown;
}

// GopherAgent will be loaded dynamically when needed
let gopherAgent: { routeMessage: (message: string, context?: RouteMessageContext) => Promise<unknown> } | null = null;

async function getGopherAgent() {
    if (!gopherAgent) {
        if (usePersistentGopherAgent) {
            const gopherModule = await import('./src/gopherAgentPersistent.js');
            const agent = (gopherModule.default || gopherModule) as { routeMessage: (message: string, context?: RouteMessageContext) => Promise<unknown> };
            gopherAgent = agent;
        } else {
            const gopherModule = await import('./src/gopherAgent.js');
            const agent = (gopherModule.default || gopherModule) as { routeMessage: (message: string, context?: RouteMessageContext) => Promise<unknown> };
            gopherAgent = agent;
        }
    }
    return gopherAgent;
}

// Extend Client to include custom properties
interface ExtendedClient extends Client {
    commands?: Collection<string, unknown>;
    paginationState?: Map<string, PaginationState>;
}

interface PaginationState {
    pages: string[];
    currentPage: number;
    messageId: string;
    userId: string;
    sourceInfo: {
        documents: string[];
        memories: Array<{ type: string; content: string; score?: number }>;
        memoryCount: number;
        chunkCount: number;
    };
}

interface IntentResult {
    intent: string;
    should_respond?: boolean;
    needs_rag?: boolean;
    needs_tools?: boolean;
    needs_memory?: boolean;
    is_casual?: boolean;
    confidence?: number;
}

interface RoutingResult {
    handler: string;
    intent?: IntentResult;
    routing_confidence?: number;
    fast_path?: boolean;
    fallback?: boolean;
}

interface ResponseData {
