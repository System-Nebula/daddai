        if (observability && typeof observability.initialize === 'function') {
            observability.initialize();
        } else if (observability.default && typeof observability.default.initialize === 'function') {
            observability.default.initialize();
        }
    } catch (error) {
        const err = error as Error;
        console.warn('[Init] Observability initialization failed (optional):', err.message);
    }
})();

