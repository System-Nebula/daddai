                        }
                    } else {
                        console.log(`⚠️ No relevant memories found for query: "${cleanedQuestion}"`);
                    }
                }
            } catch (error) {
                console.error('Memory retrieval error:', error);
                
                // Last resort: Try direct name extraction if this is a name question
                if (/name/i.test(cleanedQuestion) && preRetrievedMemories.length > 0) {
                    logger.info(`🔍 Attempting direct name extraction after error...`);
                    try {
                        const namePatterns = [
                            /(?:my name is|i'm|i am|call me|i go by)\s+([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*)/i,
                            /(?:name is|called|goes by)\s+([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*)/i,
                            /([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*)\s+(?:is my name|here|speaking)/i
                        ];
                        
                        let extractedName: string | null = null;
                        for (const memory of preRetrievedMemories) {
                            const content = memory.content || '';
                            for (const pattern of namePatterns) {
                                const match = content.match(pattern);
                                if (match && match[1]) {
                                    extractedName = match[1].trim();
                                    if (!['Bot', 'GopherBot', 'Gophie', 'User', 'The', 'A'].includes(extractedName)) {
                                        break;
                                    }
                                }
                            }
                            if (extractedName) break;
                        }
                        
                        if (extractedName) {
                            logger.info(`✅ Extracted name directly from memories: ${extractedName}`);
                            response = {
                                answer: `omggg ofc i know ur name, silly! it's ${extractedName}~! 💖 how could i forget my fave person~? hehe~ 😘`,
                                context_chunks: 0,
                                memories_used: preRetrievedMemories.length,
                                source_documents: [],
                                source_memories: preRetrievedMemories.map(m => ({ 
                                    type: m.memory_type || m.type || 'unknown', 
                                    content: (m.content || '').substring(0, 100),
                                    score: m.score !== undefined ? m.score : undefined
                                }))
                            };
                        }
                    } catch (extractError) {
                        logger.debug(`Name extraction failed: ${extractError}`);
                    }
                }
            }
        }
        
        // Use simple chat if RAG not needed or failed
        logger.info(`📋 Step 10: Checking if chat service needed...`);
        logger.info(`   response=${response ? 'SET' : 'NULL'}, hasRAGResponse=${hasRAGResponse}, useRAG=${useRAG}, hasImageGeneration=${hasImageGeneration}, hasUrl=${hasUrl}`);
        // CRITICAL: Don't use chat service if URL is detected - wait for tool execution to complete
        // The RAG service will handle URL processing and tool calls
        if (!response && !hasRAGResponse && !hasImageGeneration && !hasUrl) {
            logger.info(`💬 Using simple chat service (handler=${handler}, useRAG=${useRAG}, hasRAGResponse=${hasRAGResponse})`);
            
            // For memory questions (especially name questions), use memory-based response instead of simple chat
            if (isMemoryQuestion && preRetrievedMemories.length > 0) {
                logger.info(`🧠 Memory question detected - using memory-based response instead of simple chat`);
                try {
                    const MIN_MEMORY_SCORE = /name/i.test(cleanedQuestion) ? 0.2 : 0.3;
                    const relevantMemoriesFiltered = preRetrievedMemories.filter(m => (m.score || 0) >= MIN_MEMORY_SCORE);
                    
                    if (relevantMemoriesFiltered.length > 0) {
                        logger.info(`🧠 Using ${relevantMemoriesFiltered.length} pre-retrieved memories for memory question`);
                        const memoryContext = relevantMemoriesFiltered.map(m => m.content || '').join('\n\n');
                        
                        const memoryPrompt = `You are Gophie, a factual and analytical AI assistant.
You provide accurate, well-reasoned responses based on evidence and data.
You have access to conversation history. Answer the user's question based ONLY on the information provided in the conversation history below. Be specific, direct, and accurate.

IMPORTANT - SPEAKING STYLE:
- Be clear, concise, and professional
- Use proper grammar and complete sentences
- Present information logically and systematically
- Support statements with evidence when available
- When uncertain, acknowledge limitations rather than speculating
- Maintain a helpful but objective tone

Conversation History:
${memoryContext}

User Question: ${cleanedQuestion}

IMPORTANT: 
- Extract specific numbers, facts, and details from the conversation history
- If the question asks about quantities (like "how many gold pieces"), look for exact numbers in the history
- If someone gave something to someone else, state the exact amount
- CRITICALLY IMPORTANT FOR NAME EXTRACTION:
  * If the user asks "what's my name?" or "do you know my name?" or "make sure you know my name", look for phrases like "my name is X", "I'm X", "I am X", "call me X" in the conversation history
  * Extract the ACTUAL NAME from the conversation history and use it directly
  * Don't use placeholders like "your name" or "[Your Name]" - use the real name from the history
  * If you find a name in the history, use it confidently and professionally in your response
- Be concise and factual
- Present information clearly and accurately

Answer:`;
                        
                        const memoryResponse = await Promise.race([
                            chatService.chat(memoryPrompt, []),
                            new Promise<string>((_, reject) => 
                                setTimeout(() => reject(new Error('Memory chat timeout')), 20000)
                            )
                        ]) as string;
                        
                        response = {
                            answer: memoryResponse,
                            context_chunks: 0,
                            memories_used: relevantMemoriesFiltered.length,
                            source_documents: [],
                            source_memories: relevantMemoriesFiltered.map(m => ({ 
                                type: m.memory_type || m.type || 'unknown', 
                                content: (m.content || '').substring(0, 100),
                                score: m.score !== undefined ? m.score : undefined
                            }))
                        };
                        logger.info(`✅ Generated memory-based response using ${relevantMemoriesFiltered.length} memories`);
                    } else {
                        logger.warn(`⚠️ Pre-retrieved memories didn't meet threshold, falling back to simple chat`);
                    }
                } catch (error) {
                    const err = error as Error;
                    logger.warn(`⚠️ Failed to generate memory-based response: ${err.message}, falling back to simple chat`);
                }
            }
            
            // If we still don't have a response, use simple chat
            if (!response) {
                try {
                    logger.info(`📤 Calling chatService.chat with question: "${cleanedQuestion.substring(0, 50)}..."`);
                    logger.info(`📤 Conversation history length: ${conversationHistory.length}`);
                    const chatStartTime = Date.now();
                    // Convert conversation history to expected format
                    const formattedHistoryForChat = conversationHistory.map(msg => ({
                        role: msg.role || 'user',
                        content: msg.content || ''
                    }));
                
                const chatResponse = await Promise.race([
                    chatService.chat(cleanedQuestion, formattedHistoryForChat),
                    new Promise<string>((_, reject) => 
                        setTimeout(() => reject(new Error('Chat timeout')), 110000)
                    )
                ]) as string;
                    const chatElapsed = Date.now() - chatStartTime;
                    logger.info(`✅ Chat service responded in ${chatElapsed}ms: ${chatResponse ? chatResponse.substring(0, 100) : 'empty'}...`);
                    response = {
                        answer: chatResponse,
                        context_chunks: 0,
                        memories_used: 0
                    };
                } catch (error) {
                    const err = error as Error;
                    logger.error(`❌ Chat service error: ${err.message}`);
                    logger.error(`   Stack: ${err.stack}`);
                    response = {
                        answer: `Sorry, I encountered an error: ${err.message}. Please try again.`,
                        context_chunks: 0,
                        memories_used: 0
                    };
                }
            }
        } else {
            logger.info(`⏭️ Skipping chat service: response=${response ? 'SET' : 'NULL'}, hasRAGResponse=${hasRAGResponse}`);
        }
        
        // Final check: ensure response exists
        if (!response) {
            console.error('❌ No response generated! This should not happen.');
            response = {
                answer: 'I apologize, but I encountered an error processing your request. Please try again.',
                context_chunks: 0,
                memories_used: 0,
                source_documents: [],
                source_memories: []
            };
        }
        
        // Save conversation turn
        if (response.answer && response.answer.trim()) {
            try {
                await conversationManager.addMessage(userId, question, response.answer, message.channel.id);
            } catch (error) {
                const err = error as Error;
                logger.warn('Error saving conversation (non-critical):', { error: err.message });
            }
        } else {
            logger.debug('Skipping conversation save - empty answer');
        }
        
        // Store bot response as separate memory (non-blocking)
        if (response.answer && response.answer.length > 20) {
            (async () => {
                try {
                    const user = message.author;
                    const username = user.username;
                    
                    const mentionedUserMatch = question.match(/<@!?(\d+)>/);
                    const mentionedUserId = mentionedUserMatch ? mentionedUserMatch[1] : null;
                    
                    const botResponseMemory = `Bot response to: "${cleanedQuestion}"\n\n${response.answer}`;
                    const channelName = 'name' in message.channel ? message.channel.name : 'DM';
                    await memoryService.storeMemory(
                        message.channel.id,
                        botResponseMemory,
                        'bot_response',
                        { 
                            source: useRAG ? 'rag_response' : 'chat_response',
                            question: question,
                            response_type: useRAG ? 'rag' : 'chat'
                        },
                        channelName,
                        userId,
                        username,
                        mentionedUserId || undefined
                    );
                    console.log(`✅ Bot response stored for channel ${message.channel.id}`);
                } catch (error) {
                    console.error('❌ Error storing bot response:', error);
                }
            })();
        }
        
        // Store important user information as long-term memory (non-blocking)
        const shouldStoreUserMemory = response.answer && (
            response.answer.length > 50 ||
            /my name is|i'm|i am|call me/i.test(question) ||
            /i have|i own|i like|i prefer|i want|i've given|i gave|i'm going|i'm leaving/i.test(question) ||
            /remember|don't forget|important/i.test(question) ||
            /what's my name|who am i|what did i tell you/i.test(question)
        );
        
        if (shouldStoreUserMemory && response.answer) {
            (async () => {
                try {
                    let memoryContent = `Q: ${question}\nA: ${response.answer}`;
                    
                    const nameMatch = question.match(/(?:my name is|i'm|i am|call me)\s+([a-zA-Z]+)/i);
                    if (nameMatch) {
                        memoryContent = `User's name: ${nameMatch[1]}\n\n${memoryContent}`;
                    }
                    
                    const factPatterns = [
                        /(?:i have|i own|i like|i prefer|i want)\s+(.+)/i,
                        /(?:i've given|i gave|i'm giving|i'm going to give)\s+(?:@?\w+)?\s*(\d+)\s*(?:gold|coins?|pieces?)/i,
                        /(?:i'm going|i'm leaving)\s+(?:to|with)\s+(.+)/i
                    ];
                    
                    for (const pattern of factPatterns) {
                        const factMatch = question.match(pattern);
                        if (factMatch) {
                            memoryContent = `User fact: ${factMatch[1] || factMatch[0]}\n\n${memoryContent}`;
                            break;
                        }
                    }
                    
                    const user = message.author;
                    const username = user.username;
                    
                    const mentionedUserMatch = question.match(/<@!?(\d+)>/);
                    const mentionedUserId = mentionedUserMatch ? mentionedUserMatch[1] : null;
                    
                    const channelName = 'name' in message.channel ? message.channel.name : 'DM';
                    await memoryService.storeMemory(
                        message.channel.id,
                        memoryContent,
                        'conversation',
                        { source: useRAG ? 'rag_response' : 'chat_response' },
                        channelName,
                        userId,
                        username,
                        mentionedUserId || undefined
                    );
                    console.log(`✅ Channel memory stored for channel ${message.channel.id}`);
                } catch (error) {
                    const err = error as Error;
                    console.error('❌ Error storing user memory:', error);
                    console.error('Error details:', err.message, err.stack);
                }
            })();
        }
        
        // Send response using embeds with pagination
        let answer = response.answer || '';
        
        let responseSent = false;
        
        // Check for image generation results in tool_calls
        let imageBuffer: Buffer | null = null;
        let imageFilename: string | null = null;
        if (response.tool_calls && Array.isArray(response.tool_calls)) {
            logger.debug(`🔍 Checking ${response.tool_calls.length} tool calls for image generation`);
            for (const toolCall of response.tool_calls) {
                logger.debug(`🔍 Tool call: tool=${toolCall.tool}, has result=${!!toolCall.result}, has result.result=${!!(toolCall.result && toolCall.result.result)}`);
                
                if (toolCall.tool === 'generate_image') {
                    type ToolResultType = { success?: boolean; image_base64?: string; image_path?: string; filename?: string; error?: string; result?: { success?: boolean; image_base64?: string; image_path?: string; filename?: string } };
                    let toolResult: ToolResultType | null = null;
                    if (toolCall.result && typeof toolCall.result === 'object' && 'result' in toolCall.result && toolCall.result.result) {
                        toolResult = toolCall.result.result as ToolResultType;
                    } else if (toolCall.result && typeof toolCall.result === 'object') {
                        toolResult = toolCall.result as ToolResultType;
                    }
                    
                    if (toolResult && toolResult.success) {
                        logger.info(`🎨 Found generate_image tool result with success=true`);
                        if (toolResult.image_base64) {
                            try {
                                imageBuffer = Buffer.from(toolResult.image_base64, 'base64');
                                imageFilename = toolResult.filename || 'generated_image.png';
                                logger.info(`✅ Successfully decoded base64 image: ${imageFilename} (${imageBuffer.length} bytes)`);
                                break;
                            } catch (error) {
                                const err = error as Error;
                                logger.error(`❌ Error decoding base64 image: ${err.message}`);
                            }
                        } else if (toolResult.image_path) {
                            try {
                                if (fs.existsSync(toolResult.image_path)) {
                                    imageBuffer = fs.readFileSync(toolResult.image_path);
                                    imageFilename = toolResult.filename || 'generated_image.png';
                                    logger.info(`🎨 Found generated image (file): ${toolResult.image_path}`);
                                    try {
                                        fs.unlinkSync(toolResult.image_path);
                                        logger.debug(`🗑️ Deleted temp image file: ${toolResult.image_path}`);
                                    } catch (deleteError) {
                                        const err = deleteError as Error;
                                        logger.warn(`⚠️ Could not delete temp file: ${err.message}`);
                                    }
                                    break;
                                }
                            } catch (error) {
                                const err = error as Error;
                                logger.error(`❌ Error reading image file: ${err.message}`);
                            }
                        } else {
                            logger.warn(`⚠️ generate_image succeeded but no image_base64 or image_path found in result`);
                            logger.debug(`   Tool result keys: ${Object.keys(toolResult).join(', ')}`);
                        }
                    } else {
                        logger.debug(`   Tool result success=${toolResult?.success}, error=${toolResult?.error}`);
                    }
                }
            }
        } else {
            logger.debug(`🔍 No tool_calls found in response (tool_calls=${response.tool_calls})`);
        }
        
        const MAX_EMBED_DESCRIPTION = 4096;
        const PAGINATION_THRESHOLD = 2000;
        
        const isYouTubeResponse = hasUrl && (
            /youtube\.com|youtu\.be/i.test(question) || 
            (response.source_documents && response.source_documents.some(doc => /youtube\.com|youtu\.be/i.test(String(doc))))
        );
        
        const isWebsiteResponse = hasUrl && !isYouTubeResponse;
        
        // Use pagination if response is long OR if it's a YouTube/website URL response
        if (answer.length > PAGINATION_THRESHOLD || ((isYouTubeResponse || isWebsiteResponse) && answer.length > 500)) {
            const pages: string[] = [];
            let remaining = answer;
            
            while (remaining.length > 0) {
                if (remaining.length <= MAX_EMBED_DESCRIPTION) {
                    pages.push(remaining);
                    break;
                }
                
                let splitPoint = MAX_EMBED_DESCRIPTION;
                const lastPeriod = remaining.lastIndexOf('.', MAX_EMBED_DESCRIPTION);
                const lastNewline = remaining.lastIndexOf('\n', MAX_EMBED_DESCRIPTION);
                
                if (lastPeriod > MAX_EMBED_DESCRIPTION * 0.8) {
                    splitPoint = lastPeriod + 1;
                } else if (lastNewline > MAX_EMBED_DESCRIPTION * 0.8) {
                    splitPoint = lastNewline + 1;
                }
                
                pages.push(remaining.substring(0, splitPoint).trim());
                remaining = remaining.substring(splitPoint).trim();
            }
            
            const createEmbed = (pageIndex: number): EmbedBuilder => {
                const embed = new EmbedBuilder()
                    .setColor(isYouTubeResponse ? 0xFF0000 : 0x5865F2)
                    .setDescription(pages[pageIndex])
                    .setFooter({ 
                        text: `Page ${pageIndex + 1} of ${pages.length}`,
                        iconURL: client.user?.displayAvatarURL() ?? undefined
                    })
                    .setTimestamp();
                
                if (pageIndex === 0) {
                    if (isYouTubeResponse) {
                        embed.setTitle('📺 YouTube Video Summary');
                    } else if (isWebsiteResponse) {
                        embed.setTitle('🌐 Website Summary');
                    }
                }
                
                if (pageIndex === 0) {
                    if (response.source_documents && response.source_documents.length > 0) {
                        const docList = response.source_documents.slice(0, 5).join(', ');
                        const moreDocs = response.source_documents.length > 5 ? ` (+${response.source_documents.length - 5} more)` : '';
                        embed.addFields({
                            name: '📄 Sources',
                            value: docList + moreDocs || 'None',
                            inline: false
                        });
                    }
                    
                    if (response.source_memories && response.source_memories.length > 0) {
                        const memoryTypes = response.source_memories.map(m => m.type).filter((v, i, a) => a.indexOf(v) === i);
                        embed.addFields({
                            name: '🧠 Memories Used',
                            value: `${response.memories_used || 0} memories (${memoryTypes.join(', ')})`,
                            inline: true
                        });
                    }
                    
                    embed.addFields({
                        name: '📊 Context',
                        value: `${Array.isArray(response.context_chunks) ? response.context_chunks.length : (response.context_chunks || 0)} chunks retrieved`,
                        inline: true
                    });
                }
                
                return embed;
            };
            
            const createButtons = (pageIndex: number): ActionRowBuilder<ButtonBuilder> | null => {
                const row = new ActionRowBuilder<ButtonBuilder>();
                
                if (pageIndex > 0) {
                    row.addComponents(
                        new ButtonBuilder()
                            .setCustomId(`page_prev_${message.id}`)
                            .setLabel('◀ Previous')
                            .setStyle(ButtonStyle.Primary)
                    );
                }
                
                if (pageIndex < pages.length - 1) {
                    row.addComponents(
                        new ButtonBuilder()
                            .setCustomId(`page_next_${message.id}`)
                            .setLabel('Next ▶')
                            .setStyle(ButtonStyle.Primary)
                    );
                }
                
                return row.components.length > 0 ? row : null;
            };
            
            const replyOptions: { embeds: EmbedBuilder[]; allowedMentions: { repliedUser: boolean }; components?: ActionRowBuilder<ButtonBuilder>[]; files?: AttachmentBuilder[] } = {
                embeds: [createEmbed(0)],
                allowedMentions: { repliedUser: false }
            };
            
            const buttons = createButtons(0);
            if (buttons) {
                replyOptions.components = [buttons];
            }
            
            if (imageBuffer) {
                try {
                    const attachment = new AttachmentBuilder(imageBuffer, { name: imageFilename || 'generated_image.png' });
                    replyOptions.files = [attachment];
                    logger.info(`📎 Attaching image from memory: ${imageFilename}`);
                } catch (error) {
                    const err = error as Error;
                    logger.error(`❌ Error attaching image: ${err.message}`);
                }
            }
            
            if (!responseSent) {
                // Delete thinking message if it exists
                if (thinkingMessage) {
                    try {
                        await thinkingMessage.delete();
                    } catch (error) {
                        // Ignore delete errors
                    }
                }
                
                const sentMessage = await message.reply(replyOptions);
                responseSent = true;
                
                if (!client.paginationState) {
                    client.paginationState = new Map();
                }
                client.paginationState.set(`page_${message.id}`, {
                    pages: pages,
                    currentPage: 0,
                    messageId: sentMessage.id,
                    userId: userId,
                    sourceInfo: {
                        documents: response.source_documents || [],
                        memories: response.source_memories || [],
                        memoryCount: response.memories_used || 0,
                        chunkCount: Array.isArray(response.context_chunks) ? response.context_chunks.length : (response.context_chunks || 0)
                    }
                });
                
                const collector = sentMessage.createMessageComponentCollector({
                    filter: (interaction) => {
                        const state = client.paginationState?.get(`page_${message.id}`);
                        return state ? interaction.user.id === state.userId : false;
                    },
                    time: 300000
                });
                
                collector.on('collect', async (interaction) => {
                    const state = client.paginationState?.get(`page_${message.id}`);
                    if (!state) {
                        await interaction.reply({ content: 'This pagination has expired.', ephemeral: true });
                        return;
                    }
                    
                    if (interaction.customId === `page_prev_${message.id}`) {
                        state.currentPage = Math.max(0, state.currentPage - 1);
                    } else if (interaction.customId === `page_next_${message.id}`) {
                        state.currentPage = Math.min(state.pages.length - 1, state.currentPage + 1);
                    }
                    
                    const updateOptions: { embeds: EmbedBuilder[]; components: ActionRowBuilder<ButtonBuilder>[] } = {
                        embeds: [createEmbed(state.currentPage)],
                        components: createButtons(state.currentPage) ? [createButtons(state.currentPage)!] : []
                    };
                    
                    await interaction.update(updateOptions);
                });
                
                collector.on('end', () => {
                    client.paginationState?.delete(`page_${message.id}`);
                });
            }
            
        } else {
            // Single page embed
            const embedDescription = answer && answer.trim() ? answer : 'I received your message, but I\'m still thinking... Please try again in a moment.';
            
            const embed = new EmbedBuilder()
                .setColor(isYouTubeResponse ? 0xFF0000 : 0x5865F2)
                .setDescription(embedDescription)
                .setFooter({ 
                    text: 'Response',
                    iconURL: client.user?.displayAvatarURL() ?? undefined
                })
                .setTimestamp();
            
            if (isYouTubeResponse) {
                embed.setTitle('📺 YouTube Video Summary');
            } else if (isWebsiteResponse) {
                embed.setTitle('🌐 Website Summary');
            }
            
            if (response.source_documents && response.source_documents.length > 0) {
                const docList = response.source_documents.slice(0, 5).join(', ');
                const moreDocs = response.source_documents.length > 5 ? ` (+${response.source_documents.length - 5} more)` : '';
                embed.addFields({
                    name: '📄 Sources',
                    value: docList + moreDocs || 'None',
                    inline: false
                });
            }
            
            if (response.source_memories && response.source_memories.length > 0) {
                const memoryTypes = response.source_memories.map(m => m.type).filter((v, i, a) => a.indexOf(v) === i);
                embed.addFields({
                    name: '🧠 Memories Used',
                    value: `${response.memories_used || 0} memories (${memoryTypes.join(', ')})`,
                    inline: true
                });
            }
            
            const contextChunks = Array.isArray(response.context_chunks) ? response.context_chunks.length : (response.context_chunks || 0);
            if (contextChunks > 0) {
                embed.addFields({
                    name: '📊 Context',
                    value: `${contextChunks} chunks retrieved`,
                    inline: true
                });
            }
            
            const replyOptions: { embeds: EmbedBuilder[]; allowedMentions: { repliedUser: boolean }; files?: AttachmentBuilder[] } = {
                embeds: [embed],
                allowedMentions: { repliedUser: false }
            };
            
            if (imageBuffer) {
                try {
                    const attachment = new AttachmentBuilder(imageBuffer, { name: imageFilename || 'generated_image.png' });
                    replyOptions.files = [attachment];
                    logger.info(`📎 Attaching image from memory: ${imageFilename}`);
                } catch (error) {
                    const err = error as Error;
                    logger.error(`❌ Error attaching image: ${err.message}`);
                }
            }
            
            if (!responseSent) {
                // Delete thinking message if it exists
                if (thinkingMessage) {
                    try {
                        await thinkingMessage.delete();
                    } catch (error) {
                        // Ignore delete errors
                    }
                }
                
                await message.reply(replyOptions);
                responseSent = true;
            }
        }
        
    } catch (error) {
        console.error('Error processing question:', error);
        
        // Delete thinking message if it exists
        if (thinkingMessage) {
            try {
                await thinkingMessage.delete();
            } catch (deleteError) {
                // Ignore delete errors
            }
        }
        
        await message.reply({
            content: 'Sorry, I encountered an error processing your question. Please try again.',
            allowedMentions: { repliedUser: false }
        });
    }
}

// Interaction handler (slash commands and buttons)
client.on(Events.InteractionCreate, async (interaction) => {
    // Handle button interactions (pagination)
    if (interaction.isButton()) {
        const buttonInteraction = interaction as ButtonInteraction;
        const customId = buttonInteraction.customId;
        
        // Check if it's a pagination button
        if (customId.startsWith('page_prev_') || customId.startsWith('page_next_')) {
            // Extract message ID from custom ID (format: page_prev_123456789 or page_next_123456789)
            const parts = customId.split('_');
            const messageId = parts.slice(2).join('_'); // Get everything after page_prev_ or page_next_
            const state = client.paginationState?.get(`page_${messageId}`);
            
            if (!state) {
                await buttonInteraction.reply({ 
                    content: 'This pagination has expired. Please ask your question again.', 
                    ephemeral: true 
                });
                return;
            }
            
            // Verify user owns this pagination
            if (buttonInteraction.user.id !== state.userId) {
                await buttonInteraction.reply({ 
                    content: 'Only the person who asked the question can navigate pages.', 
                    ephemeral: true 
                });
                return;
            }
            
            // Update page
            if (customId.startsWith('page_prev_')) {
                state.currentPage = Math.max(0, state.currentPage - 1);
            } else if (customId.startsWith('page_next_')) {
                state.currentPage = Math.min(state.pages.length - 1, state.currentPage + 1);
            }
            
            // Create updated embed and buttons
            const createEmbed = (pageIndex: number): EmbedBuilder => {
                const embed = new EmbedBuilder()
                    .setColor(0x5865F2)
                    .setDescription(state.pages[pageIndex])
                    .setFooter({ 
                        text: `Page ${pageIndex + 1} of ${state.pages.length}`,
                        iconURL: client.user?.displayAvatarURL() || undefined
                    })
                    .setTimestamp();
                
                // Add source information only on first page
                if (pageIndex === 0 && state.sourceInfo) {
                    if (state.sourceInfo.documents && state.sourceInfo.documents.length > 0) {
                        const docList = state.sourceInfo.documents.slice(0, 5).join(', ');
                        const moreDocs = state.sourceInfo.documents.length > 5 ? ` (+${state.sourceInfo.documents.length - 5} more)` : '';
                        embed.addFields({
                            name: '📄 Sources',
                            value: docList + moreDocs || 'None',
                            inline: false
                        });
                    }
                    
                    if (state.sourceInfo.memories && state.sourceInfo.memories.length > 0) {
                        const memoryTypes = state.sourceInfo.memories.map(m => m.type).filter((v, i, a) => a.indexOf(v) === i);
                        embed.addFields({
                            name: '🧠 Memories Used',
                            value: `${state.sourceInfo.memoryCount || 0} memories (${memoryTypes.join(', ')})`,
                            inline: true
                        });
                    }
                    
                    // Only show context if chunks were actually retrieved
                    if (state.sourceInfo.chunkCount && state.sourceInfo.chunkCount > 0) {
                        embed.addFields({
                            name: '📊 Context',
                            value: `${state.sourceInfo.chunkCount} chunks retrieved`,
                            inline: true
                        });
                    }
                }
                
                return embed;
            };
            
            const createButtons = (pageIndex: number): ActionRowBuilder<ButtonBuilder> | null => {
                const row = new ActionRowBuilder<ButtonBuilder>();
                
                if (pageIndex > 0) {
                    row.addComponents(
                        new ButtonBuilder()
                            .setCustomId(`page_prev_${messageId}`)
                            .setLabel('◀ Previous')
                            .setStyle(ButtonStyle.Primary)
                    );
                }
                
                if (pageIndex < state.pages.length - 1) {
                    row.addComponents(
                        new ButtonBuilder()
                            .setCustomId(`page_next_${messageId}`)
                            .setLabel('Next ▶')
                            .setStyle(ButtonStyle.Primary)
                    );
                }
                
                return row.components.length > 0 ? row : null;
            };
            
            const updateOptions: { embeds: EmbedBuilder[]; components: ActionRowBuilder<ButtonBuilder>[] } = {
                embeds: [createEmbed(state.currentPage)],
                components: createButtons(state.currentPage) ? [createButtons(state.currentPage)!] : []
            };
            
            await buttonInteraction.update(updateOptions);
            return;
        }
    }
    
    // Handle slash commands
    if (!interaction.isChatInputCommand()) return;
    
    const command = client.commands?.get(interaction.commandName) as { execute: (interaction: ChatInputCommandInteraction, ...args: unknown[]) => Promise<void> } | undefined;
    
    if (!command) {
        console.error(`No command matching ${interaction.commandName} was found.`);
        return;
    }
    
    try {
        await command.execute(interaction as ChatInputCommandInteraction, conversationManager, ragService, memoryService, documentService, configManager);
    } catch (error) {
        const err = error as Error;
        console.error(`Error executing ${interaction.commandName}:`, err);
        const errorMessage = { content: 'There was an error while executing this command!', ephemeral: true };
        if (interaction.replied || interaction.deferred) {
            await interaction.followUp(errorMessage);
        } else {
            await interaction.reply(errorMessage);
        }
    }
});

// Error handlers to prevent crashes
process.on('unhandledRejection', (error: unknown) => {
    console.error('❌ Unhandled promise rejection:', error);
    // Don't exit - keep the bot running
});

process.on('uncaughtException', (error: Error) => {
    console.error('❌ Uncaught exception:', error);
    // Don't exit - keep the bot running
});

// Handle disconnects and reconnections
client.on(Events.Error, (error: Error) => {
    console.error('❌ Discord client error:', error);
});

client.on(Events.ShardDisconnect, (event: unknown, id: number) => {
    console.log(`⚠️  Shard ${id} disconnected:`, event);
    console.log('🔄 Will attempt to reconnect automatically...');
});

client.on(Events.ShardReconnecting, (id: number) => {
    console.log(`🔄 Shard ${id} reconnecting...`);
});

client.on(Events.ShardReady, (id: number) => {
    console.log(`✅ Shard ${id} is ready!`);
});

// Handle disconnects - Discord.js should auto-reconnect, but we'll log it
client.on(Events.ShardDisconnect, () => {
    console.log('⚠️  Bot disconnected from Discord');
    console.log('🔄 Discord.js will attempt to reconnect automatically...');
});

// Login
const token = process.env.DISCORD_TOKEN;
if (!token) {
    console.error('❌ DISCORD_TOKEN not found in environment variables!');
    process.exit(1);
}

// Graceful shutdown
process.on('SIGINT', () => {
    console.log('\n🛑 Shutting down gracefully...');
    ragService.shutdown();
    client.destroy();
    process.exit(0);
});

process.on('SIGTERM', () => {
    console.log('\n🛑 Shutting down gracefully...');
    ragService.shutdown();
    client.destroy();
    process.exit(0);
});

client.login(token).catch((error: Error) => {
    console.error('❌ Error logging in:', error);
    ragService.shutdown();
    process.exit(1);
});

